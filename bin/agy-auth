#!/bin/bash
set -e

# Auto-locate KUBECONFIG
KUBECONFIG="${KUBECONFIG:-/Users/allen/Development/k8s-gitops/kubeconfig}"
if [ ! -f "$KUBECONFIG" ] && [ -f "$HOME/.kube/config" ]; then
    KUBECONFIG="$HOME/.kube/config"
fi
export KUBECONFIG

WORKSPACE="${1:-home-automation}"

# Normalize workspace name (e.g. ws-home-automation or home-automation)
WORKSPACE_NAME=$(echo "$WORKSPACE" | sed 's/^ws-//')

DEPLOYMENT="deployment/ws-${WORKSPACE_NAME}"
NAMESPACE="devcontainers"

echo "=========================================================================="
echo " 🔑 Antigravity Automated Workspace Authenticator"
echo " Target Workspace: ws-${WORKSPACE_NAME}"
echo "=========================================================================="

# Check if deployment exists
if ! kubectl get "$DEPLOYMENT" -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "❌ Deployment ws-${WORKSPACE_NAME} not found in namespace ${NAMESPACE}."
    echo "Available workspaces:"
    kubectl get deployments -n "$NAMESPACE" -l app --no-headers | awk '{print "  - " $1}'
    exit 1
fi

# Fetch the latest auth URL from the workspace container
echo "Fetching latest OAuth URL from ws-${WORKSPACE_NAME}..."
AUTH_LOG=$(kubectl exec -n "$NAMESPACE" "$DEPLOYMENT" -- /bin/sh -c "cat /tmp/antigravity-auth.url 2>/dev/null || tail -n 5 ~/.gemini/antigravity/auth_urls.log 2>/dev/null" || true)

if [ -z "$AUTH_LOG" ]; then
    echo ""
    echo "⚠️  No OAuth URL detected yet in ws-${WORKSPACE_NAME}."
    echo "1. Open https://ws-${WORKSPACE_NAME}.k8s.mrv.thebends.org/ in your browser."
    echo "2. Click 'Sign In'."
    echo "3. Then re-run: agy-auth ${WORKSPACE_NAME}"
    exit 1
fi

OAUTH_URL=$(echo "$AUTH_LOG" | grep -oE 'https://[^"'\'' ]+' | tail -n 1)

if [ -z "$OAUTH_URL" ]; then
    echo ""
    echo "⚠️  Could not extract OAuth URL from container log."
    echo "Log output:"
    echo "$AUTH_LOG"
    exit 1
fi

# Extract redirect_uri callback port
CALLBACK_PORT=$(echo "$OAUTH_URL" | grep -oE 'redirect_uri=http.*localhost(%3A|:)[0-9]+' | grep -oE '[0-9]+$' || true)

if [ -z "$CALLBACK_PORT" ]; then
    echo "⚠️  Could not detect callback port from OAuth URL."
    echo "OAuth URL: ${OAUTH_URL}"
    exit 1
fi

echo ""
echo "Found OAuth URL for ws-${WORKSPACE_NAME}:"
echo "Callback Port: ${CALLBACK_PORT}"
echo ""

# Start background kubectl port-forward
echo "Starting kubectl port-forward ${CALLBACK_PORT}:${CALLBACK_PORT}..."
kubectl port-forward -n "$NAMESPACE" "$DEPLOYMENT" "${CALLBACK_PORT}:${CALLBACK_PORT}" >/dev/null 2>&1 &
PF_PID=$!

# Ensure cleanup on exit
trap 'echo ""; echo "Stopping port-forward (PID $PF_PID)..."; kill $PF_PID 2>/dev/null || true' EXIT

sleep 1

echo "Opening OAuth URL in browser..."
open "$OAUTH_URL" 2>/dev/null || xdg-open "$OAUTH_URL" 2>/dev/null || echo "Please open URL in browser: $OAUTH_URL"

echo ""
echo "=========================================================================="
echo "✅ Browser opened! Complete authentication in your browser window."
echo "Press Ctrl+C when finished to stop port-forwarding."
echo "=========================================================================="

wait $PF_PID
